<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="FrameLayout">

    <data>

        <variable
            name="bean"
            type="com.hash.bean.mine.UserInfoBean" />

        <import type="com.hash.mine.R" />

    </data>

    <merge>


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_profile_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_collapseMode="parallax"
            app:srcCompat="@mipmap/mine_top_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mine_header_bg" />


        <!-- 个人信息内容容器 -->
        <LinearLayout
            android:id="@+id/profile_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="@dimen/dp_80"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            app:layout_collapseMode="pin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 头像 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:padding="@dimen/dp_1"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/image_style_circleStyle"
                    app:srcCompat="@mipmap/avatar"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/dp_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- 昵称 -->
                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{bean.userInfo.nickname}"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{`Hash号：` + bean.userInfo.id}"
                        android:textColor="@color/textTertiary"
                        android:textSize="@dimen/sp_10" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP属地：未知"
                        android:textColor="@color/textTertiary"
                        android:textSize="@dimen/sp_10" />
                </LinearLayout>
            </LinearLayout>

            <!-- 简介 -->
            <TextView
                android:id="@+id/tv_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="点击这里，填写简介"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <!-- 粉丝/关注等数据 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20">

                <include
                    android:id="@+id/note_follow_stat"
                    layout="@layout/layout_mine_info_stat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:label="@{@string/stat_following}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:value="@{`61`}" />


                <include
                    android:id="@+id/note_fan_stat"
                    layout="@layout/layout_mine_info_stat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_20"
                    app:label="@{@string/stat_fan}"
                    app:layout_constraintBottom_toBottomOf="@id/note_follow_stat"
                    app:layout_constraintStart_toEndOf="@id/note_follow_stat"
                    app:layout_constraintTop_toTopOf="@id/note_follow_stat"
                    app:value="@{`23`}" />


                <include
                    android:id="@+id/note_like_collect_stat"
                    layout="@layout/layout_mine_info_stat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_20"
                    app:label="@{@string/stat_like_collect}"
                    app:layout_constraintBottom_toBottomOf="@id/note_follow_stat"
                    app:layout_constraintStart_toEndOf="@id/note_fan_stat"
                    app:layout_constraintTop_toTopOf="@id/note_follow_stat"
                    app:value="@{`143`}" />


                <FrameLayout
                    android:id="@+id/btn_profile_settings"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_26"
                    android:background="@drawable/round_20_btn_bg"
                    app:layout_constraintBottom_toBottomOf="@id/note_follow_stat"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/note_follow_stat">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:layout_gravity="center"
                        app:srcCompat="@mipmap/icon_setting" />

                </FrameLayout>


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_26"
                    android:layout_marginEnd="@dimen/dp_20"
                    android:background="@drawable/round_20_btn_bg"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_14"
                    android:text="@string/edit_profile_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12"
                    app:layout_constraintBottom_toBottomOf="@id/btn_profile_settings"
                    app:layout_constraintEnd_toStartOf="@id/btn_profile_settings"
                    app:layout_constraintTop_toTopOf="@id/btn_profile_settings" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 编辑按钮等 -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/card_manage_shop"
                        layout="@layout/layout_mine_info_card"
                        android:layout_width="@dimen/dp_110"
                        android:layout_height="wrap_content"
                        app:icon="@{R.mipmap.icon_manage_shop}"
                        app:label="@{@string/manage_shop}"
                        app:value="@{@string/manage_product}" />


                    <include
                        android:id="@+id/card_manage_group"
                        layout="@layout/layout_mine_info_card"
                        android:layout_width="@dimen/dp_110"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        app:icon="@{R.mipmap.icon_manage_group}"
                        app:label="@{@string/manage_group}"
                        app:value="@{@string/view_details}" />

                    <include
                        android:id="@+id/card_manage_idea"
                        layout="@layout/layout_mine_info_card"
                        android:layout_width="@dimen/dp_110"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        app:icon="@{R.mipmap.icon_manage_idea}"
                        app:label="@{@string/manage_idea}"
                        app:value="@{@string/learn_idea}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

    </merge>

</layout>
