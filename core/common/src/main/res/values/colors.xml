<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        应用默认（浅色）主题颜色（values/colors.xml）

        说明：
        - 使用常见的 "colorOn*" 命名约定（例如 colorOnPrimary、colorOnBackground、colorOnSurface），与夜间文件保持一致。
        - 如果需要在某个背景上使用专用前景色，使用相应的 colorOn*（例如 colorOnPrimary）。
    -->

    <!-- 主色（品牌色） -->
    <color name="primary">#F50057</color>

    <!-- 主要背景与 surface（浅色主题） -->
    <color name="background">#FFFFFFFF</color>
    <color name="surface">#FFFFFFFF</color>

    <!-- 新增：次级深色背景（用于次级按钮、卡片或强调区域） -->
    <!-- 颜色原始值：#453F38 （不含透明度），使用不透明表示：#FF453F38 -->
    <color name="backgroundSecondary">#FF453F38</color>
    <!-- 放在 backgroundSecondary 上的文字/图标颜色（默认白色） -->
    <color name="colorOnBackgroundSecondary">#FFFFFFFF</color>

    <!-- 对应背景上的前景 / 文本颜色（使用 colorOn* 命名） -->
    <!-- colorOnPrimary: 放在 primary 背景上的文字 / 图标（例如带颜色的按钮上的文字） -->
    <color name="colorOnPrimary">#FFFFFFFF</color>
    <!-- colorOnBackground: 放在应用整体背景 background 上的主要文字 -->
    <color name="colorOnBackground">#FF000000</color>
    <!-- colorOnSurface: 放在 surface（卡片 / 弹窗 / 面板）上的文字 -->
    <color name="colorOnSurface">#FF000000</color>

    <!-- 文本语义色（按优先级） -->
    <!-- textTitle: 页面/卡片标题，最高优先级 -->
    <color name="textTitle">#FF000000</color>
    <!-- textBody: 正文/主要信息 -->
    <color name="textBody">#DE000000</color>
    <!-- textSecondary: 次要文字（描述、辅助信息） -->
    <color name="textSecondary">#8A000000</color>
    <!-- textCaption: 更低优先级的文字（注释、元信息） -->
    <color name="textCaption">#61000000</color>
    <!-- textLabel: 表单字段 label / 小标题 -->
    <color name="textLabel">#99000000</color>
    <!-- 新增：额外语义文本色（中性色/占位类） -->
    <color name="textTertiary">#FFBFBEBC</color>
    <!-- textButton: 按钮上的文字（若按钮使用 primary 背景，建议使用 colorOnPrimary） -->
    <color name="textButton">#FFFFFFFF</color>

    <!-- 状态、提示与特殊用途文字 -->
    <color name="textHint">#60000000</color>
    <color name="textDisabled">#42000000</color>
    <color name="textLink">#FF1B3452</color>
    <color name="textError">#FFD32F2F</color>
    <color name="textSuccess">#FF2E7D32</color>

    <!-- 分割线 / 边框 -->
    <color name="divider">#1F000000</color>
    <!-- 新增：浅灰分割线，颜色值 E9E9E9 -->
    <color name="dividerLight">#FFE9E9E9</color>

    <!-- 透明与通用色 -->
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="gray">#FF808080</color>

    <!-- 备用 / 语义色（便于组件直接引用） -->
    <color name="red">#FFFF0000</color>
    <color name="green">#FF008000</color>
    <color name="blue">#FF0000FF</color>
    <color name="orange">#FFFFA500</color>

    <!-- 按钮背景语义色（浅色主题） -->
    <!-- 说明：按语义定义按钮背景，使用 selector 管理按下/禁用状态。命名以 button 开头。 -->
    <!-- 主要按钮（Primary） -->
    <color name="buttonPrimary">#F50057</color>               <!-- 主色，优先操作 -->
    <color name="buttonPrimaryPressed">#D4004A</color>       <!-- 主色按下态（深一层） -->

    <!-- 次要按钮（Secondary） -->
    <color name="buttonSecondary">#FFEEEEEE</color>          <!-- 次要按钮背景（浅灰） -->
    <color name="buttonSecondaryPressed">#FFE0E0E0</color>   <!-- 次要按钮按下态 -->

    <!-- 危险类按钮（Destructive） -->
    <color name="buttonDestructive">#D32F2F</color>          <!-- 删除/危险操作 -->
    <color name="buttonDestructivePressed">#C62828</color>

    <!-- 透明/幽灵按钮（无填充，仅文字或边框） -->
    <color name="buttonGhostBackground">#00000000</color>
    <color name="buttonOutlineBorder">#FFBDBDBD</color>

    <!-- 禁用态与抬起态 -->
    <color name="buttonDisabled">#FFBDBDBD</color>
    <color name="buttonElevatedBackground">#FFFFFFFF</color>

    <!-- 按钮前景（文字/图标）优先复用现有语义色：colorOnPrimary / textBody / colorOnSurface -->

    <!-- 兼容/占位色（用于占位 / 默认图标等） -->
    <color name="placeholder">#FFBDBDBD</color>

</resources>
